# Server-only secrets. Copy to .env.local and fill in real values.
# Never commit real values. Never import these into client components.
#
# Required: powers Jev decisions (typed UI structure choices).
AI_GATEWAY_API_KEY=
# Optional: paid diffusion (black-forest-labs/flux-schnell via Replicate).
# When absent, the app uses the free keyless image provider instead, so the
# full pipeline works with only AI_GATEWAY_API_KEY set.
REPLICATE_API_TOKEN=
# Optional (later): object storage / persistent metadata
BLOB_READ_WRITE_TOKEN=
DATABASE_URL=
REDIS_URL=
